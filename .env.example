# Tienda
SHOPIFY_SHOP_DOMAIN=            # ej: natulim-dev.myshopify.com (sin https://)
SHOPIFY_API_VERSION=2026-10     # última versión estable de la Admin API

# Autenticación, opción 1: token fijo de Admin API (shpat_...)
SHOPIFY_ADMIN_TOKEN=

# Autenticación, opción 2: app del Dev Dashboard (client credentials grant).
# Si SHOPIFY_ADMIN_TOKEN está vacío, se obtiene un token con este par y se renueva solo.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Verificación HMAC de webhooks. Si se deja vacío, se usa SHOPIFY_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=

# Webhooks
PUBLIC_BASE_URL=                # URL pública del túnel, sin barra final

# Requerimiento 3
DATABASE_PATH=data/orders.db
SYNC_START_AT=                  # ISO 8601 UTC, ej: 2026-11-12T00:00:00Z. Pedidos creados antes se ignoran.

# Requerimiento 4
CANARIAS_TAG=cambio_a_pedido_para_canarias
ADDRESS_METAFIELD_NAMESPACE=natulim
ADDRESS_METAFIELD_KEY=shipping_address_hash
